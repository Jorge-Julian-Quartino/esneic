import wollok.game.*

import esneic.*

program EsneicGame {
	game.title("Esneic")
	game.cellSize(64)
	game.height(20)
	game.width(20)
	game.addVisual(cabeza)
	game.addVisual(cuerpo)
	game.addVisual(cola)
	game.addVisual(manzana)
	
	keyboard.up().onPressDo({ cabeza.cambiarDireccion("arriba") })
	keyboard.down().onPressDo({ cabeza.cambiarDireccion("abajo") })
	keyboard.right().onPressDo({ cabeza.cambiarDireccion("derecha") })
	keyboard.left().onPressDo({ cabeza.cambiarDireccion("izquierda") })

	//La cabeza se mueve apenas empeiza el juego. Habría que poner un cartel que diga:
	// "presiona cualquier tecla para empezar a jugar"
	game.onTick(200, "mover",{cabeza.mover()}) 
	game.onTick(200, "seguir",{cuerpo.seguirLaCabeza()}) //Creo que esto puede juntarse con cabeza.mover()
	
	//add assets in asset folder, for example, for the background
  	// game.boardGround("fondo2.jpg")

	//


	game.start()
}
